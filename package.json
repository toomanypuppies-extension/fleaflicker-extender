{
  "name": "fleaflicker-extender",
  "version": "0.5.3",
  "source": "src/main.js",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "si:dev": "cross-env NODE_ENV=development STANDALONE=true parcel serve --target=site",
    "si:build": "shx rm -rf dist/site && cross-env STANDALONE=true parcel build --target=site",
    "si:serveprod": "yarn si:build && serve -s -p 1234 dist/site/",
    "ex:dev": "cross-env NODE_ENV=development parcel watch --no-hmr --target=extension",
    "ex:build": "parcel build --target=extension && node scripts/check-extension-css.mjs dist/extension/main.css",
    "ex:build:chrome": "shx rm -rf extension-build-chrome/dist && parcel build --target=extension --dist-dir=extension-build-chrome/dist && node scripts/check-extension-css.mjs extension-build-chrome/dist/extension/main.css",
    "ex:build:firefox": "shx rm -rf extension-build-firefox/dist && parcel build --target=extension --dist-dir=extension-build-firefox/dist && node scripts/check-extension-css.mjs extension-build-firefox/dist/extension/main.css",
    "gh-mv-docs": "shx mv dist/site docs && shx cp CNAME docs/CNAME",
    "vuestic-px": "node scripts/vuestic-px.mjs",
    "test": "node --test --import ./test/support/setup.mjs \"test/**/*.test.mjs\""
  },
  "targets": {
    "extension": {
      "context": "browser",
      "outputFormat": "global",
      "optimize": false,
      "scopeHoist": false,
      "sourceMap": false,
      "source": "src/main.js"
    },
    "site": {
      "context": "browser",
      "outputFormat": "global",
      "optimize": false,
      "scopeHoist": false,
      "sourceMap": true,
      "source": "src/index.html"
    }
  },
  "alias": {
    "process": false
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "2.12.0",
    "@parcel/transformer-vue": "^2.12.0",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "6.0.0",
    "parcel": "^2.12.0",
    "sass": "^1.49.8",
    "serve": "^14.1.2",
    "shx": "^0.4.0"
  },
  "dependencies": {
    "@vueuse/core": "^7.6.2",
    "axios": "^0.26.0",
    "date-fns": "^2.28.0",
    "lodash": "^4.17.21",
    "vue": "^3.5.43",
    "vue-router": "4",
    "vuestic-ui": "1.10.3",
    "vuex": "^4.0.2"
  }
}
